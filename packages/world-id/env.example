# Copy these names into the repo's gitignored .env (never commit values).
# The scripts read $NOREN_ENV_FILE, this checkout's .env, then the main checkout's .env.

# From https://developer.world.org (app type: external / IDKit, World ID 4.0 enabled)
WORLD_APP_ID=
WORLD_RP_ID=
# The RP signing key shown once when World ID 4.0 is configured. Server only.
WORLD_RP_SIGNING_KEY=
# production = real World App (phones). staging = World ID Simulator (needs a staging action).
WORLD_ENVIRONMENT=production
# selfie (default) | proof_of_human | passport
WORLD_CREDENTIAL=selfie

# Starter line policy (defaults shown; hard ceiling 100 USDC)
NOREN_STARTER_LIMIT_USDC6=25000000
NOREN_STARTER_DAYS=30

# The bridge agent's human-starter CRE workflow (run in the local simulator with --broadcast)
NOREN_STARTER_CRE_PROJECT=
NOREN_STARTER_CRE_WORKFLOW=
NOREN_STARTER_CRE_TARGET=local-fork
NOREN_STARTER_CRE_TRIGGER_INDEX=
NOREN_STARTER_CRE_ENV_FILE=
