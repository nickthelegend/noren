  function deploy(address forwarder) internal returns (NorenRateOracle) {
    string[] memory codes = new string[](9);
    address[] memory proxies = new address[](9);
    uint8[] memory minor = new uint8[](9);
    (codes[0], proxies[0], minor[0]) = ('USD', address(0), 2);
    (codes[1], proxies[1], minor[1]) = ('EUR', 0xDd5B15443cd733D3966a50a3E48cB7DF9Fb5DE0D, 2);
    (codes[2], proxies[2], minor[2]) = ('GBP', 0x3E0a1296e6CBF0a8fa54F2b4909643214EfCeE4D, 2);
    (codes[3], proxies[3], minor[3]) = ('JPY', 0xF9Fc1C20C82d774A3787845E73E41BCbF7F38F25, 0);
    (codes[4], proxies[4], minor[4]) = ('CAD', 0x5024DF70A748e5f1E720AAe8EEfc590430d71573, 2);
    (codes[5], proxies[5], minor[5]) = ('AUD', 0xaF452c2EA72b6E08AB64a67133a13C4ED35343eb, 2);
    (codes[6], proxies[6], minor[6]) = ('MXN', 0x302eaa6cd6f7AdDdc973fAC2Bb8fa32e9Ce19f21, 2);
    (codes[7], proxies[7], minor[7]) = ('BRL', 0x3406DB72AC5136b89eba6808CFcaD83aF523B3C2, 2);
    (codes[8], proxies[8], minor[8]) = ('KRW', 0x07040A33A0204596e927595D0994C5D841d7d61D, 0);
    return new NorenRateOracle(forwarder, 5042, USDC_USD, MAX_AGE, codes, proxies, minor);
  }

  function decode() internal pure returns (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory updates) {
    return abi.decode(REPORT, (uint64, uint64, address, NorenRateOracle.RateUpdate[]));
  }

  function encode(uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory updates) internal pure returns (bytes memory) {
    return abi.encode(chainId, sourceBlock, usdcFeed, updates);
  }
