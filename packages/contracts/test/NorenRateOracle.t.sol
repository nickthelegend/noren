contract NorenRateOracleTest {
  Vm private constant vm = Vm(address(uint160(uint256(keccak256('hevm cheat code')))));
  NorenRateOracle private oracle;

  function setUp() public {
    vm.warp(Captured.TIMESTAMP);
    oracle = Captured.deploy(Captured.MOCK_FORWARDER);
  }

  function _deliver(bytes memory report) private {
    vm.prank(Captured.MOCK_FORWARDER);
    oracle.onReport('', report);
  }

  function _quote(string memory c, uint256 amount) private view returns (uint256 usdc) {
    (usdc,,,) = oracle.quote(c, amount);
  }

  function testCapturedReportStoresAllNineRates() public {
    _deliver(Captured.REPORT);
    require(oracle.lastSourceBlock() == Captured.SOURCE_BLOCK, 'source block');
    require(oracle.currencies().length == 9, 'currencies');
    // Expected values are the ones `cast call quote(...)` returned on the fork after the same report.
    require(_quote('USD', 10_000) == 100_018_404, 'USD');
    require(_quote('EUR', 10_000) == 112_183_642, 'EUR');
    require(_quote('GBP', 10_000) == 134_768_298, 'GBP');
    require(_quote('JPY', 100) == 633_377, 'JPY');
    require(_quote('CAD', 10_000) == 71_255_434, 'CAD');
    require(_quote('AUD', 10_000) == 69_111_717, 'AUD');
    require(_quote('MXN', 10_000) == 5_344_765, 'MXN');
    require(_quote('BRL', 10_000) == 18_253_832, 'BRL');
    require(_quote('KRW', 100) == 73_602, 'KRW');
    require(oracle.rateE18('EUR') == 1_121_836_417_900_893_764, 'EUR rate');
  }

  function testQuoteReturnsRoundIdsForAudit() public {
    _deliver(Captured.REPORT);
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    (uint256 usdc, uint80 fiatRound, uint80 usdcRound, uint256 oldest) = oracle.quote('EUR', 10_000);
    require(usdc == 112_183_642, 'usdc');
    require(fiatRound == u[1].fiatUsdRoundId && usdcRound == u[1].usdcUsdRoundId, 'rounds');
    require(oldest == (u[1].fiatUsdUpdatedAt < u[1].usdcUsdUpdatedAt ? u[1].fiatUsdUpdatedAt : u[1].usdcUsdUpdatedAt), 'oldest');
  }

  function testQuoteRoundsUp() public {
    _deliver(Captured.REPORT);
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    // 1 JPY minor unit = 1 JPY: fiat * 1e6 * 1e8 / (usdc * 1e8) rounded up.
    uint256 num = uint256(u[3].fiatUsdAnswer) * 1e6 * 1e8;
    uint256 den = uint256(u[3].usdcUsdAnswer) * 1e8;
    require(_quote('JPY', 1) == num / den + (num % den == 0 ? 0 : 1), 'ceil');
  }

  function testRejectsCallerThatIsNotTheForwarder() public {
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.UnauthorizedForwarder.selector, address(this), Captured.MOCK_FORWARDER));
    oracle.onReport('', Captured.REPORT);
  }

  function testRejectsOlderSourceBlock() public {
    _deliver(Captured.REPORT);
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    bytes memory older = Captured.encode(chainId, sourceBlock - 1, usdcFeed, u);
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.OlderReport.selector, sourceBlock - 1, sourceBlock));
    oracle.onReport('', older);
  }

  function testRejectsOlderRoundInNewerBlock() public {
    _deliver(Captured.REPORT);
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    uint64 stored = u[1].fiatUsdUpdatedAt;
    u[1].fiatUsdRoundId -= 1;
    u[1].fiatUsdUpdatedAt = stored - 1;
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.OlderRound.selector, bytes3('EUR'), stored - 1, stored));
    oracle.onReport('', Captured.encode(chainId, sourceBlock + 1, usdcFeed, u));
  }

  function testRejectsStaleReport() public {
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    // USDC/USD is the oldest round in the report; one second past maxAge makes it stale.
    vm.warp(uint256(u[0].usdcUsdUpdatedAt) + Captured.MAX_AGE + 1);
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.StalePrice.selector, bytes3('USD'), uint256(u[0].usdcUsdUpdatedAt), Captured.MAX_AGE));
    oracle.onReport('', Captured.REPORT);
  }

  function testRejectsRoundFromTheFuture() public {
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    vm.warp(uint256(u[3].fiatUsdUpdatedAt) - oracle.MAX_FUTURE_SKEW() - 1);
    oracle = Captured.deploy(Captured.MOCK_FORWARDER);
    // JPY is the first entry in report order whose round is newer than block time + skew.
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.FutureRound.selector, bytes3('JPY'), u[3].fiatUsdUpdatedAt));
    oracle.onReport('', Captured.REPORT);
  }

  function testStoredQuoteGoesStaleButRateLockSurvives() public {
    _deliver(Captured.REPORT);
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    vm.warp(uint256(u[1].usdcUsdUpdatedAt) + Captured.MAX_AGE + 1);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.StalePrice.selector, bytes3('EUR'), uint256(u[1].usdcUsdUpdatedAt), Captured.MAX_AGE));
    oracle.quote('EUR', 10_000);
    // An invoice locked to these rounds still verifies on-chain.
    require(oracle.quoteAtRounds('EUR', 10_000, u[1].fiatUsdRoundId, u[1].usdcUsdRoundId) == 112_183_642, 'locked');
    require(oracle.verifyQuote('EUR', 10_000, u[1].fiatUsdRoundId, u[1].usdcUsdRoundId, 112_183_642), 'verify');
    require(!oracle.verifyQuote('EUR', 10_000, u[1].fiatUsdRoundId, u[1].usdcUsdRoundId, 112_183_641), 'undercharge');
  }

  function testUnknownRoundsRevert() public {
    _deliver(Captured.REPORT);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.UnknownRounds.selector, bytes3('EUR'), uint80(1), uint80(2)));
    oracle.quoteAtRounds('EUR', 10_000, 1, 2);
  }

  function testSameRoundsAgainIsANoOp() public {
    _deliver(Captured.REPORT);
    NorenRateOracle.Rate memory first = oracle.latestRate('EUR');
    vm.warp(Captured.TIMESTAMP + 60);
    _deliver(Captured.REPORT);
    NorenRateOracle.Rate memory second = oracle.latestRate('EUR');
    require(first.recordedAt == second.recordedAt && second.recordedAt == Captured.TIMESTAMP, 'not a no-op');
  }

  function testRejectsTamperedRate() public {
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    uint256 real = u[2].rateE18;
    u[2].rateE18 = real + 1;
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.RateMismatch.selector, bytes3('GBP'), real + 1, real));
    oracle.onReport('', Captured.encode(chainId, sourceBlock, usdcFeed, u));
  }

  function testRejectsSwappedFeed() public {
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    address gbp = u[2].fiatUsdFeed;
    u[1].fiatUsdFeed = gbp;
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.FeedMismatch.selector, bytes3('EUR'), gbp, 0xDd5B15443cd733D3966a50a3E48cB7DF9Fb5DE0D));
    oracle.onReport('', Captured.encode(chainId, sourceBlock, usdcFeed, u));
  }

  function testRejectsWrongSourceChain() public {
    (, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.WrongSourceChain.selector, uint64(5042002), uint64(5042)));
    oracle.onReport('', Captured.encode(5042002, sourceBlock, usdcFeed, u));
  }

  function testRejectsNonPositiveAnswer() public {
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    u[4].fiatUsdAnswer = 0;
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.InvalidPrice.selector, bytes3('CAD'), int256(0), u[4].usdcUsdAnswer));
    oracle.onReport('', Captured.encode(chainId, sourceBlock, usdcFeed, u));
  }

  function testRejectsUnconfiguredCurrency() public {
    (uint64 chainId, uint64 sourceBlock, address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    u[5].currency = 'CHF';
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.UnknownCurrency.selector, bytes3('CHF')));
    oracle.onReport('', Captured.encode(chainId, sourceBlock, usdcFeed, u));
  }

  function testWorkflowOwnerCheckUsesMetadata() public {
    address workflowOwner = address(0xC0FFEE);
    oracle.setExpectedWorkflowOwner(workflowOwner);
    bytes memory wrong = abi.encodePacked(bytes32(uint256(1)), bytes10('daf1668de8'), address(0xBAD), bytes2(0x0001));
    vm.prank(Captured.MOCK_FORWARDER);
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.InvalidWorkflowOwner.selector, address(0xBAD), workflowOwner));
    oracle.onReport(wrong, Captured.REPORT);
    bytes memory right = abi.encodePacked(bytes32(uint256(1)), bytes10('daf1668de8'), workflowOwner, bytes2(0x0001));
    vm.prank(Captured.MOCK_FORWARDER);
    oracle.onReport(right, Captured.REPORT);
    require(oracle.lastSourceBlock() == Captured.SOURCE_BLOCK, 'accepted');
  }

  function testOnlyOwnerAdmin() public {
    vm.prank(address(0xBEEF));
    vm.expectRevert(abi.encodeWithSelector(NorenRateOracle.NotOwner.selector));
    oracle.setForwarder(address(0xBEEF));
    oracle.setForwarder(0x76c9cf548b4179F8901cda1f8623568b58215E62);
    require(oracle.forwarder() == 0x76c9cf548b4179F8901cda1f8623568b58215E62, 'forwarder');
  }

  function testSupportsReceiverInterface() public view {
    require(oracle.supportsInterface(0x01ffc9a7), 'erc165');
    require(oracle.supportsInterface(bytes4(keccak256('onReport(bytes,bytes)'))), 'receiver');
  }

  function testRoundsForReportsStoredRounds() public {
    string[] memory codes = new string[](2);
    (codes[0], codes[1]) = ('EUR', 'KRW');
    (uint80[] memory f0, ) = oracle.roundsFor(codes);
    require(f0[0] == 0 && f0[1] == 0, 'empty');
    _deliver(Captured.REPORT);
    (, , , NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    (uint80[] memory f1, uint80[] memory c1) = oracle.roundsFor(codes);
    require(f1[0] == u[1].fiatUsdRoundId && f1[1] == u[8].fiatUsdRoundId && c1[0] == u[1].usdcUsdRoundId, 'rounds');
  }
}

/// @notice Live checks (need network): the captured report matches Chainlink on Arc mainnet, and the real
///         Arc Testnet MockKeystoneForwarder delivers the captured raw report to NorenRateOracle.
contract NorenRateOracleLiveTest {
  Vm private constant vm = Vm(address(uint160(uint256(keccak256('hevm cheat code')))));

  function testCapturedRoundsAreRealArcMainnetChainlinkRounds() public {
    vm.createSelectFork('https://arc-rpc.publicnode.com');
    (uint64 chainId, , address usdcFeed, NorenRateOracle.RateUpdate[] memory u) = Captured.decode();
    require(chainId == 5042 && block.chainid == 5042, 'Arc mainnet');
    for (uint256 i; i < u.length; ++i) {
      _check(usdcFeed, u[i].usdcUsdRoundId, u[i].usdcUsdAnswer, u[i].usdcUsdUpdatedAt, u[i].usdcUsdDecimals);
      if (u[i].fiatUsdFeed != address(0)) {
        _check(u[i].fiatUsdFeed, u[i].fiatUsdRoundId, u[i].fiatUsdAnswer, u[i].fiatUsdUpdatedAt, u[i].fiatUsdDecimals);
      }
    }
  }

  function _check(address feed, uint80 roundId, int256 answer, uint64 updatedAt, uint8 decimals) private view {
    (uint80 id, int256 a,, uint256 t,) = IAggregator(feed).getRoundData(roundId);
    require(id == roundId && a == answer && t == updatedAt, 'round does not match Arc mainnet');
    require(IAggregator(feed).decimals() == decimals, 'decimals');
  }

  function testRealMockForwarderDeliversCapturedReport() public {
    vm.createSelectFork('https://rpc.testnet.arc.io');
    require(block.chainid == 5042002, 'Arc Testnet');
    require(Captured.MOCK_FORWARDER.code.length > 0, 'forwarder code');
    vm.warp(Captured.TIMESTAMP);
    NorenRateOracle oracle = Captured.deploy(Captured.MOCK_FORWARDER);
    IMockKeystoneForwarder(Captured.MOCK_FORWARDER).report(address(oracle), Captured.RAW_REPORT, '', new bytes[](0));
    require(oracle.lastSourceBlock() == Captured.SOURCE_BLOCK, 'not delivered');
    (uint256 usdc,,,) = oracle.quote('EUR', 10_000);
    require(usdc == 112_183_642, 'EUR quote');
  }
}
