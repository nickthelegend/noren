# Noren web build. Names only; copy to packages/web/.env.local (gitignored) and fill in. All optional: unset = local dev.
# Hosted mode: Arc is the public Arc testnet only (no fork/live switch, no fork badges).
VITE_NOREN_HOSTED=
# The Noren server API base (default http://127.0.0.1:8790).
VITE_NOREN_API=
# Robinhood RPC for the app, e.g. the VPS-hosted mainnet snapshot; wins over the server's /config when set.
VITE_NOREN_RH_RPC=
# Privy (optional): VITE_PRIVY_APP_ID=
