# Copy these names into the repo's gitignored .env (never commit values). pnpm dev:all reads this checkout's .env,
# else the main checkout's .env. See docs/RECLAIM.md.

# Reclaim Protocol (zkTLS), from https://dev.reclaimprotocol.org: the application's ID and secret (required). The secret
# stays on the Noren server; ReclaimProofRequest.init runs server-side only.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
# Optional. Provider IDs are public and built in (packages/server/src/reclaim-providers.ts). RECLAIM_PROVIDER_ID picks the
# one shown first; RECLAIM_PROVIDER_IDS="label:id,label:id" replaces an ID per label.
RECLAIM_PROVIDER_ID=
RECLAIM_PROVIDER_IDS=
