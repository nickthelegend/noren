# Copy these names into the repo's gitignored .env (never commit values). pnpm dev:all reads this checkout's .env,
# else the main checkout's .env. See docs/RECLAIM.md.

# Reclaim Protocol (zkTLS), from https://dev.reclaimprotocol.org: the application's ID and secret, and the provider
# the app uses. The secret stays on the Noren server; ReclaimProofRequest.init runs server-side only.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
# Optional label shown in the app, e.g. "Experian - RW Credit Score".
RECLAIM_PROVIDER_NAME=
