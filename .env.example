# Noren: every environment variable, by name. Copy to a gitignored .env (or .env.arc-deployer for the
# deployer key) and fill in values there. Never commit real values. See docs/DEPLOY.md for which step
# needs which variable. Values shown are public defaults, never secrets.

# ---------------------------------------------------------------- public deploy (scripts/deploy-public.sh)
# Deployer / owner key for public testnets (Arc, Base Sepolia, Ethereum Sepolia, Robinhood testnet).
NOREN_DEPLOYER_KEY=
# Optional: address only (dry runs without a key), and the ASP postman (defaults to the deployer).
NOREN_DEPLOYER_ADDRESS=
NOREN_POSTMAN_ADDRESS=
# Which env file the deploy scripts read (default .env, then .env.arc-deployer).
NOREN_ENV_FILE=
ENV_FILE=
# Arc testnet RPC (default https://rpc.testnet.arc.io).
NOREN_RPC_URL=
ARC_TESTNET_RPC=
# Arc mainnet read-only RPC for Chainlink Data Feeds (default https://arc-rpc.publicnode.com).
ARC_MAINNET_RPC=
NOREN_PRICE_RPC=
# Chainlink CRE: "simulate" = cre workflow simulate --broadcast through Chainlink's MockKeystoneForwarder
# (testnet only; no DON signatures). "production" = a real KeystoneForwarder (needs DON access).
NOREN_CRE_MODE=
# Production mode only: the KeystoneForwarder address and the workflow owner every receiver pins.
CRE_FORWARDER=
CRE_WORKFLOW_OWNER=
# The CRE CLI's own key variable (scripts pass NOREN_DEPLOYER_KEY through a temporary 0600 env file).
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=
CRE_DIR=
# CCIP deploy (packages/ccip/script/Deploy.s.sol): role, router and chain selector per chain.
ROLE=
CCIP_ROUTER=
CCIP_SELECTOR=
ARC_LIQUIDITY_USDC6=
HUB_FUND_WEI=
ARC_GATEWAY=
ARC_ACTION_ROUTER=
BASE_GATEWAY=
BASE_HUB=
RH_GATEWAY=
RH_INBOX=
SEPOLIA_GATEWAY=
GATEWAY=
ROUTE_NEXT=
ROUTE_NEXT_CHAIN=
ROUTE_FINAL=
ROUTE_FINALITY_DEPTH=
ROUTE_GAS=
FINAL_CHAIN=
PAYLOAD=
SEPOLIA_RPC=
ROBINHOOD_TESTNET_RPC=
# CCTP hook deploy (packages/cctp/scripts/deploy-arc-hook.sh) overrides.
FORWARDER=
ROUTER=
# Cross-chain Aqua (packages/xchain-aqua) deploy and route setup.
XCHAIN_FORWARDER=
XCHAIN_ARC_SETTLER=
XCHAIN_SETTLER=
XCHAIN_TOKEN=
XCHAIN_FEED=
XCHAIN_UI=
XCHAIN_OUT=
XCHAIN_OUT_TOKEN=
XCHAIN_ROUTES=
XCHAIN_IN_TOKENS=
XCHAIN_ALLOC=
XCHAIN_BID_BPS=
XCHAIN_ASK_BPS=
XCHAIN_PAYOUT=
XCHAIN_RH_CHAIN_ID=
NOREN_AQUA_LIVE=
NOREN_AQUA_ARC_RPC=
NOREN_AQUA_MAKER_USDG=
NOREN_SKIP_XCHAIN=
# Explorer verification (Blockscout needs no key; set one only for higher rate limits).
BLOCKSCOUT_API_KEY=

