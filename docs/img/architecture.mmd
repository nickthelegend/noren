flowchart TB
  CUS(["<b>Customer</b><br/>browser key · proof made on device"])
  MER(["<b>Merchant</b><br/>dashboard · API · signed webhooks"])

  subgraph OFF["Noren services · off-chain"]
    direction LR
    WEB["<b>@noren/web</b><br/>Noren Merchant · Noren app<br/>hosted checkout · landing"]
    SDK["<b>@noren/core SDK</b><br/>shield · proveInvoicePayment<br/>refundInbox · verifyWebhook"]
    SRV["<b>Merchant server</b><br/>invoices · relays payment + gas<br/>settles credit + stock payments · webhooks"]
    ASP["<b>ASP postman</b><br/>scans deposits · checks USDC<br/>isBlacklisted · posts roots"]
    UW["<b>History underwriter</b><br/>reads wallet history<br/>signs EIP-712 attestation"]
    ZG["<b>0G Private Computer</b><br/>sealed credit check<br/>request ID · TEE verified"]
    WID["<b>World ID</b><br/>IDKit · nullifier<br/>one starter line per human"]
  end

  subgraph ARC["Arc testnet · chain 5042002 · gas paid in USDC"]
    direction LR
    CL["<b>NorenCreditLine</b><br/>payInvoice · repay · starter lines<br/>emits Drawn / Repaid"]
    CO["<b>NorenCheckout</b><br/>invoice-bound withdrawal<br/>pays merchant payout · private refunds"]
    EP["<b>Entrypoint</b> (ERC-1967 proxy)<br/>0xbow Privacy Pools · ASP root"]
    POOL["<b>PrivacyPoolComplex</b><br/>USDC pool · Groth16 verifiers"]
    USDC[("<b>USDC</b><br/>0x3600…0000")]
    RO["<b>NorenRateOracle</b><br/>Chainlink-derived FX rates"]
  end

  STUDIO{{"<b>Arc Studio</b><br/>import · compile · test · deploy"}}

  subgraph CLK["Chainlink"]
    direction LR
    CREB["<b>CRE workflow · credit bridge</b><br/>log triggers both ways · HTTP trigger"]
    CRES["<b>CRE workflow · settlement desk</b><br/>Relay / Across quotes vs Chainlink"]
    CREP["<b>CRE workflow · pricing</b><br/>cron → read feeds → write"]
    DF["<b>Data Feeds</b><br/>Arc mainnet: EUR/USD, USDC/USD …<br/>Robinhood: stocks, ETH, USDG"]
  end

  subgraph RH["Robinhood Chain · mainnet state on a local node (4663)"]
    direction LR
    TS["<b>NorenCredit</b><br/>credit lines · Pay in 3<br/>EIP-712 attestations"]
    GW["<b>NorenGateway</b><br/>pay with stocks / ETH / USDG"]
    LQ["<b>NorenLiquidity + SwapVM</b><br/>1inch Aqua makers · NorenOraclePeg<br/>payments + liquidations"]
    VA["<b>NorenVault</b><br/>USDG lender pool · fallback"]
    SD["<b>NorenSettlementDesk</b><br/>USDG → USDC on Arc"]
    ST[("<b>Stock Tokens · USDG · WETH · Aqua</b><br/>real mainnet contracts")]
  end

  CUS --> WEB
  MER --> WEB
  WEB --- SDK
  WEB <-->|"HTTP · SSE"| SRV
  SDK -->|"① shield USDC"| EP
  SDK -->|"payInvoice"| CL
  SRV -->|"② relay proof"| CO
  CO -->|"③ pool.withdraw, context = invoice"| POOL
  CO -.->|"refund: Entrypoint.deposit"| EP
  EP --> POOL
  POOL --- USDC
  ASP -->|"updateRoot"| EP
  SRV -.->|"quote, read-only"| DF
  STUDIO -.->|"imported, compiled, deployed"| CO
  CL <-->|"onReport ⇄ Drawn / Repaid"| CREB
  CREB <-->|"CreditLineOpened ⇄ onReport"| TS
  DF --> CREP
  CREP -->|"onReport"| RO
  DF -.->|"prices"| TS
  UW -->|"attestation"| TS
  UW -.->|"features"| ZG
  WEB -.-> WID
  WID -->|"starter line"| CREB
  SDK -->|"pay with stocks"| GW
  GW --> LQ
  GW -.->|"fallback"| VA
  TS -->|"liquidations"| LQ
  TS --- VA
  SRV -->|"settle USDG"| SD
  SD <-->|"request ⇄ approve"| CRES
  LQ --- ST

